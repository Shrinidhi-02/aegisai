# AegisAI Application
APP_NAME=AegisAI
APP_ENV=development
DEBUG=true

# Security
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./aegis.db

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Request limits
MAX_INPUT_LENGTH=8000
MAX_OUTPUT_LENGTH=12000

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Policy
DEFAULT_BLOCK_THRESHOLD=70
DEFAULT_WARN_THRESHOLD=40

# Alerts
ALERT_WEBHOOK_URL=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=